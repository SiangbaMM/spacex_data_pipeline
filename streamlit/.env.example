# Snowflake Connection Parameters
# Copy this file to .env and fill in your actual values

# Account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_account_here

# User credentials
SNOWFLAKE_USER=SPACEX_DATA_DEV_TRANSFORM_USER
SNOWFLAKE_PASSWORD=your_password_here

# Role, warehouse, database, and schema
SNOWFLAKE_ROLE=SPACEX_DATA_DEV_TRANSFORM_ROLE
SNOWFLAKE_WAREHOUSE=SPACEX_DATA_DEV_TRANSFORM_WH
SNOWFLAKE_DATABASE=SPACEX_DATA_DEV
SNOWFLAKE_SCHEMA=CMP_SPACEX_DATA
